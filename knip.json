{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/app.js",
    "src/config/fastify-cli.js",
    "src/plugins/**/*.js",
    "src/routes/**/{routes,autohooks}.js",

    "src/client/**/*.js",
    "src/scripts/**/*.js",

    "src/{config,lib,plugins,resources,routes,test,types,workers}/**/*.test.js",
    "src/workers/bookmarks/ua.js"
  ],
  "project": ["src/**/*.{js,cjs,ts}"],
  "ignoreDependencies": ["highlight.js", "mine.css"],
  "ignoreBinaries": ["redis-server"]
}
