{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "app.js",
    "config/fastify-cli.cjs",
    "plugins/**/*.js",
    "api/routes/**/{routes,autohooks}.js",

    "client/**/*.js",
    "scripts/**/*.js",
    "{api,config,plugins,resources,runtime,worker}/**/test/**/*.js",
    "{api,config,plugins,resources,runtime,worker}/**/*.test.js",
    "worker/workers/bookmarks/ua.js"
  ],
  "project": ["{app,otel}.js", "{api,config,plugins,resources,runtime,worker}/**/*.{js,cjs,ts}", "client/**/*.js", "scripts/**/*.js"],
  "ignoreDependencies": ["highlight.js", "mine.css"],
  "ignoreBinaries": ["redis-server"]
}
