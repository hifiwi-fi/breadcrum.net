{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [

    "src/plugins/**/*.js",
    "src/api/routes/**/{routes,autohooks}.js",

    "client/**/*.js",
    "scripts/**/*.js",
    "src/**/test/**/*.js",
    "src/**/*.test.js",
    "src/worker/workers/bookmarks/ua.js"
  ],
  "project": ["src/**/*.{js,ts}", "client/**/*.js", "scripts/**/*.js"],
  "ignoreDependencies": ["highlight.js", "mine.css"],
  "ignoreBinaries": ["redis-server"]
}
