{
  "extends": "@voxpelli/tsconfig/node24.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
  },
  "include": ["api/**/*", "config/**/*", "plugins/**/*", "resources/**/*", "runtime/**/*", "worker/**/*", "client/**/*", "scripts/**/*", "eslint.config.js", "otel.js", "app.js"],
  "exclude": ["node_modules", "public", "coverage"],
}
