{
  "extends": "@voxpelli/tsconfig/node26.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
  },

  "exclude": ["node_modules", "public", "coverage"],
}
