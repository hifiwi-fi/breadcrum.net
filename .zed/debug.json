[
  {
    "label": "Debug API and worker (one process)",
    "adapter": "JavaScript",
    "type": "pwa-node",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/src/main.js",
    "args": ["--role=all"],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "console": "integratedTerminal",
    "env": {
      "NODE_ENV": "development",
      "FORCE_COLOR": "1"
    },
    "skipFiles": ["<node_internals>/**"],
    "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
  },
  {
    "label": "Debug API only",
    "adapter": "JavaScript",
    "type": "pwa-node",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/src/main.js",
    "args": ["--role=api"],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "console": "integratedTerminal",
    "env": { "NODE_ENV": "development", "FORCE_COLOR": "1" },
    "skipFiles": ["<node_internals>/**"]
  },
  {
    "label": "Debug worker only (port 3001)",
    "adapter": "JavaScript",
    "type": "pwa-node",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/src/main.js",
    "args": ["--role=worker"],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "console": "integratedTerminal",
    "env": { "NODE_ENV": "development", "FORCE_COLOR": "1", "PORT": "3001" },
    "skipFiles": ["<node_internals>/**"]
  }
]
