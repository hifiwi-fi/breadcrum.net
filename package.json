  "type": "module",
  "author": "Bret Comnes <bcomnes@gmail.com> (https://bret.io)",
  "bugs": {
    "url": "https://github.com/hifiwi-fi/breadcrum.net/issues"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@breadcrum/bookmarklet": "1.0.13",
    "@domstack/static": "^11.0.2",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@sentry/cli": "^3.5.1",
    "@types/common-tags": "^1.8.4",
    "@types/concat-stream": "^2.0.3",
    "@types/gunzip-maybe": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/user-agents": "^1.0.4",
    "@types/useragent": "^2.3.4",
    "@voxpelli/tsconfig": "^16.2.1",
    "argsclopts": "^1.0.5",
    "classnames": "^2.5.1",
    "eslint": "^10.8.0",
    "format-duration": "^4.0.0",
    "giscus": "^1.6.0",
    "highlight.js": "^11.5.0",
    "knip": "^6.7.0",
    "local-storage-proxy": "^4.0.3",
    "mine.css": "^11.0.11",
    "neostandard": "0.14.0-next",
    "npm-run-all2": "^9.0.2",
    "p-map": "^7.0.0",
    "releasearoni": "^0.2.0",
    "typescript": "~6.0.3",
    "xmlbuilder": "^15.1.1"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/bcomnes"
  },
  "homepage": "https://github.com/hifiwi-fi/breadcrum.net",
  "keywords": [],
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hifiwi-fi/breadcrum.net.git"
  },
  "scripts": {
    "clean": "rm -rf public && mkdir -p public",
    "prepublishOnly": "releasearoni --no-npm-check --no-build",
    "release": "releasearoni --no-npm-check --no-build",
    "version": "releasearoni version",
    "test": "run-s test:*",
    "test:eslint": "eslint .",
    "test:tsc": "tsc",
    "test:node": "node --experimental-test-coverage --test --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test-concurrency=1 src client scripts",
    "test:knip": "knip --dependencies",
    "watch": "run-s build && run-p watch:*",
    "watch:server": "node --watch --watch-preserve-output src/main.js --role=all",
    "watch:domstack": "pnpm run build:domstack --watch-only --drafts",
    "build": "run-s clean build:*",
    "build:domstack": "dom --src client --dest public",
    "build:verify-giscus": "node scripts/verify-giscus-patch.js --built",
    "migrate": "postgrator",
    "generate-default-env": "node scripts/api/generate-default-env.js",
    "start": "pnpm run watch",
    "start:api": "node src/main.js --role=api",
    "start:worker": "node src/main.js --role=worker",
    "deploy": "./scripts/deploy-with-sentry.sh",
    "sentry:login": "sentry-cli login",
    "knip": "knip --dependencies",
    "new-blogpost": "node scripts/create-blogpost.js --title",
    "publish-draft": "node scripts/publish-blogpost.js",
    "print-routes": "fastify print-routes src/api/app.js",
    "print-plugins": "fastify print-plugins src/api/app.js",
    "generate-dbml": "pnpm dlx pg-to-dbml --c postgres://postgres@localhost/breadcrum"
  },
  "dependencies": {
    "@breadcrum/extract-meta": "^2.0.1",
    "@bret/is-youtube-url": "^1.0.5",
    "@fastify/accepts": "^5.0.1",
    "@fastify/auth": "^5.0.1",
    "@fastify/autoload": "^6.0.1",
    "@fastify/basic-auth": "^6.0.1",
    "@fastify/circuit-breaker": "^4.0.1",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.0.0",

    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/otel": "^0.19.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@maxmind/geoip2-node": "^7.0.0",
    "@mozilla/readability": "^0.6.0",
    "@nearform/sql": "^1.10.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.219.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@passwordless-id/webauthn": "^2.3.1",
    "@preact/signals": "^2.3.2",
    "@sentry/browser": "^10.58.0",
    "@sentry/node": "^10.58.0",
    "@tanstack/preact-query": "^5.100.5",
    "abstract-cache-redis": "^2.0.0",
    "clean-deep": "^3.4.0",
    "common-tags": "^1.8.2",
    "concat-stream": "^2.0.0",
    "dompurify": "^3.4.13",
    "env-schema": "^7.0.0",
    "fast-json-body": "^1.1.0",
    "fastify": "^5.8.1",
    "fastify-cli": "^8.0.0",
    "fastify-healthcheck": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "fastify-user-agent": "^2.0.0",
    "gunzip-maybe": "^1.4.2",
    "htm": "^3.1.1",
    "hyperid": "^4.0.0",
    "ipaddr.js": "^2.3.0",
    "jsdom": "^30.0.1",
    "json-schema-to-ts": "^3.1.1",
    "jsonfeed-to-atom": "^1.2.5",
    "jsonfeed-to-rss": "^3.0.8",
    "mime-types": "^3.0.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.23.0",
    "pg-boss": "12.28.0",
    "postgrator-cli": "^10.0.0",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.6.3",
    "resolve-email": "^4.0.45",
    "type-fest": "^5.7.0",
    "undici": "^8.10.0",
    "user-agents": "^2.1.43",
    "useragent": "^2.3.0"
  },
  "packageManager": "pnpm@10.34.5",
  "imports": {
    "#api/types/*.js": "./src/api/types/*.ts",
    "#resources/types/*.js": "./src/resources/types/*.d.ts",
    "#api/*": "./src/api/*",
    "#worker/*": "./src/worker/*",
    "#resources/*": "./src/resources/*",
    "#runtime/*": "./src/runtime/*",
    "#config/*": "./src/config/*",
    "#client/*": "./client/*",
    "#components/*": "./client/components/*",
    "#hooks/*": "./client/hooks/*",
    "#layouts/*": "./client/layouts/*"
  }
}
